{% comment %} Init {% endcomment %}
{%- liquid
  assign product_collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
-%}

<section id="product-list-{{ section.id }}" data-product-list >
    <div class="page-width">
        {% comment %} Section Title {% endcomment %}
        {%- if section.settings.title != blank -%}
            <h2 class="collection-list-title inline-richtext h1 mb-4 md:mb-8">
                <strong>{{ section.settings.title | escape }}</strong>
            </h2>
        {%- endif -%}

        {% comment %} Product cards {% endcomment %}
        {%- if product_collection != blank and product_collection.products.size > 0 -%}
            <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
                {%- for product in product_collection.products limit: products_to_show -%}
                    {%- liquid
                        assign selected_variant = product.selected_or_first_available_variant
                        assign primary_media = selected_variant.featured_media | default: product.featured_media
                        assign secondary_media = blank
                        assign found_primary_media = false
                        assign color_option = blank

                        if primary_media != blank
                            for media in product.media
                                if found_primary_media and media.id != primary_media.id
                                    assign secondary_media = media
                                    break
                                endif

                                if media.id == primary_media.id
                                    assign found_primary_media = true
                                endif
                            endfor
                        endif

                        assign secondary_media = secondary_media | default: product.media[1] | default: primary_media
                        assign has_secondary_media = false

                        if secondary_media != blank and secondary_media.id != primary_media.id
                            assign has_secondary_media = true
                        endif

                        for option in product.options_with_values
                            assign option_name = option.name | downcase
                            if option_name contains 'color' or option_name contains 'colour'
                                assign color_option = option
                                break
                            endif
                        endfor
                    -%}

                    <article class="bg-white relative flex flex-col gap-6 p-6 rounded-md" data-product-card>
                        <a href="{{ product.url }}" class="group/card relative block overflow-hidden border border-borders border-solid rounded-xl" aria-label="{{ product.title | escape }}">
                            {% comment %} Sale {% endcomment %}
                            <span
                                class="font-franklin inline-block leading-9 absolute left-8 top-8 z-[2] bg-white border border-sale border-solid rounded-full px-4 py-1 font-medium text-sale{% unless selected_variant.compare_at_price > selected_variant.price %} hidden{% endunless %}"
                                data-product-sale-badge
                            >
                                {{- 'products.product.on_sale' | t -}}
                            </span>
                            
                            {%- if primary_media != blank -%}
                                <img
                                    src="{{ primary_media | image_url: width: 760 }}"
                                    srcset="
                                        {{ primary_media | image_url: width: 420 }} 420w,
                                        {{ primary_media | image_url: width: 760 }} 760w,
                                        {{ primary_media | image_url: width: 1120 }} 1120w
                                    "
                                    sizes="(min-width: 1600px) 436px, (min-width: 768px) calc(33.333vw - 97.333px), (min-width: 750px) calc(100vw - 148px), calc(100vw - 78px)"
                                    width="{{ primary_media.width }}"
                                    height="{{ primary_media.height }}"
                                    alt="{{ primary_media.alt | default: product.title | escape }}"
                                    loading="lazy"
                                    class="aspect-[3/4] h-auto w-full object-cover transition-opacity duration-200{% if has_secondary_media %} group-hover/card:opacity-0{% endif %}"
                                    data-product-primary-image
                                >

                                <img
                                    src="{{ secondary_media | image_url: width: 760 }}"
                                    srcset="
                                        {{ secondary_media | image_url: width: 420 }} 420w,
                                        {{ secondary_media | image_url: width: 760 }} 760w,
                                        {{ secondary_media | image_url: width: 1120 }} 1120w
                                    "
                                    sizes="(min-width: 1600px) 436px, (min-width: 768px) calc(33.333vw - 97.333px), (min-width: 750px) calc(100vw - 148px), calc(100vw - 78px)"
                                    width="{{ secondary_media.width }}"
                                    height="{{ secondary_media.height }}"
                                    alt="{{ secondary_media.alt | default: product.title | escape }}"
                                    loading="lazy"
                                    class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-200{% if has_secondary_media %} group-hover/card:opacity-100{% endif %}"
                                    data-product-hover-image
                                >
                            {%- else -%}
                                {{ 'product-1' | placeholder_svg_tag: 'aspect-[3/4] w-full' }}
                            {%- endif -%}
                        </a>

                        <div class="grid gap-6">
                            {% comment %} Swatches {% endcomment %}
                            {%- if color_option != blank -%}
                                <fieldset class="m-0 border-0 p-0">
                                    <legend class="visually-hidden">{{ color_option.name | escape }}</legend>
                                    <div class="flex flex-wrap gap-3">
                                        {%- for value in color_option.values -%}
                                            {%- liquid
                                                assign swatch_variant = value.variant | default: selected_variant
                                                assign swatch_media = swatch_variant.featured_media | default: primary_media
                                                assign swatch_hover_media = blank
                                                assign found_swatch_media = false

                                                if swatch_media != blank
                                                    for media in product.media
                                                        if found_swatch_media and media.id != swatch_media.id
                                                            assign swatch_hover_media = media
                                                            break
                                                        endif

                                                        if media.id == swatch_media.id
                                                            assign found_swatch_media = true
                                                        endif
                                                    endfor
                                                endif

                                                assign swatch_hover_media = swatch_hover_media | default: product.media[1] | default: swatch_media
                                                assign has_swatch_hover_media = false

                                                if swatch_hover_media != blank and swatch_hover_media.id != swatch_media.id
                                                    assign has_swatch_hover_media = true
                                                endif

                                                assign swatch_color = value.name | downcase | replace: ' ', ''
                                            -%}

                                            <button
                                                type="button"
                                                class="cursor-pointer h-8 w-8 rounded-full bg-white border-0 [&.active]:outline [&.active]:outline-1 [&.active]:outline-primary [&.active]:outline-offset-1{% if value.selected %} active{% endif %}"
                                                style="background-color: {{ swatch_color }};"
                                                aria-label="{{ value.name | escape }}"
                                                aria-pressed="{{ value.selected }}"
                                                data-product-swatch
                                                data-price="{{ swatch_variant.price | money | escape }}"
                                                data-has-hover="{{ has_swatch_hover_media }}"
                                                {% if swatch_variant.compare_at_price > swatch_variant.price %}
                                                    data-compare-price="{{ swatch_variant.compare_at_price | money | escape }}"
                                                {% endif %}
                                                {% if swatch_media != blank %}
                                                    data-primary-src="{{ swatch_media | image_url: width: 760 }}"
                                                    data-primary-srcset="{{ swatch_media | image_url: width: 420 }} 420w, {{ swatch_media | image_url: width: 760 }} 760w, {{ swatch_media | image_url: width: 1120 }} 1120w"
                                                    data-primary-alt="{{ swatch_media.alt | default: product.title | escape }}"
                                                {% endif %}
                                                {% if has_swatch_hover_media %}
                                                    data-hover-src="{{ swatch_hover_media | image_url: width: 760 }}"
                                                    data-hover-srcset="{{ swatch_hover_media | image_url: width: 420 }} 420w, {{ swatch_hover_media | image_url: width: 760 }} 760w, {{ swatch_hover_media | image_url: width: 1120 }} 1120w"
                                                    data-hover-alt="{{ swatch_hover_media.alt | default: product.title | escape }}"
                                                {% endif %}
                                            ></button>
                                        {%- endfor -%}
                                    </div>
                                </fieldset>
                            {%- endif -%}

                            <div class="grid gap-2">
                                {% comment %} Vendor {% endcomment %}
                                {%- if product.vendor != blank -%}
                                    <p class="text-sm text-title leading-7 m-0">
                                        {{ product.vendor | escape }}
                                    </p>
                                {%- endif -%}

                                {% comment %} Title {% endcomment %}
                                <a href="{{ product.url }}" class="text-primary font-medium inline-block leading-7 no-underline hover:underline">
                                    {{ product.title | escape }}
                                </a>

                                {% comment %} Price {% endcomment %}
                                <div
                                    class="flex items-center gap-2 text-sm text-title leading-7 flex-row-reverse justify-end"
                                    aria-live="polite"
                                    aria-atomic="true"
                                >
                                    {%- if selected_variant.compare_at_price > selected_variant.price -%}
                                        <span class="text-sale" data-product-price>
                                            <span class="visually-hidden hidden" data-product-regular-price-label>
                                                {{- 'products.product.price.regular_price' | t -}}
                                            </span>
                                            <span class="visually-hidden" data-product-sale-price-label>
                                                {{- 'products.product.price.sale_price' | t -}}
                                            </span>
                                            <span data-product-price-value>{{ selected_variant.price | money }}</span>
                                        </span>
                                        <s class="text-title" data-product-compare-price>
                                            <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                                            <span data-product-compare-price-value>{{ selected_variant.compare_at_price | money }}</span>
                                        </s>
                                    {%- else -%}
                                        <span data-product-price>
                                            <span class="visually-hidden" data-product-regular-price-label>
                                                {{- 'products.product.price.regular_price' | t -}}
                                            </span>
                                            <span class="visually-hidden hidden" data-product-sale-price-label>
                                                {{- 'products.product.price.sale_price' | t -}}
                                            </span>
                                            <span data-product-price-value>{{ selected_variant.price | money }}</span>
                                        </span>
                                        <s class="hidden text-title" data-product-compare-price>
                                            <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                                            <span data-product-compare-price-value></span>
                                        </s>
                                    {%- endif -%}
                                </div>
                            </div>
                        </div>
                    </article>
                {%- endfor -%}
            </div>
        {%- else -%}
            <div class="grid min-h-[260px] place-items-center border p-8 text-center text-title">
                {{- 'products.product.choose_collection' | t -}}
            </div>
        {%- endif -%}
    </div>
</section>

<script>
    (() => {
        const root = document.getElementById('product-list-{{ section.id }}');
        if (!root) return;

        // Product card updating
        const updateProductCard = (card, swatch) => {
            // Init product swatch data
            const primaryImage = card.querySelector('[data-product-primary-image]');
            const hoverImage = card.querySelector('[data-product-hover-image]');
            const price = card.querySelector('[data-product-price]');
            const priceValue = card.querySelector('[data-product-price-value]');
            const regularPriceLabel = card.querySelector('[data-product-regular-price-label]');
            const salePriceLabel = card.querySelector('[data-product-sale-price-label]');
            const comparePrice = card.querySelector('[data-product-compare-price]');
            const comparePriceValue = card.querySelector('[data-product-compare-price-value]');
            const saleBadge = card.querySelector('[data-product-sale-badge]');
            const hasHover = swatch.dataset.hasHover === 'true';
            const isOnSale = Boolean(swatch.dataset.comparePrice);

            if (primaryImage && swatch.dataset.primarySrc) {
                primaryImage.src = swatch.dataset.primarySrc;
                primaryImage.srcset = swatch.dataset.primarySrcset;
                primaryImage.alt = swatch.dataset.primaryAlt;
            }

            if (primaryImage) {
                primaryImage.classList.toggle('group-hover/card:opacity-0', hasHover);
            }

            if (hoverImage) {
                hoverImage.classList.toggle('group-hover/card:opacity-100', hasHover);
            }

            if (hasHover && hoverImage && swatch.dataset.hoverSrc) {
                hoverImage.src = swatch.dataset.hoverSrc;
                hoverImage.srcset = swatch.dataset.hoverSrcset;
                hoverImage.alt = swatch.dataset.hoverAlt;
            }

            if (price && priceValue && swatch.dataset.price) {
                priceValue.textContent = swatch.dataset.price;
                price.classList.toggle('text-sale', isOnSale);
            }

            if (regularPriceLabel && salePriceLabel) {
                regularPriceLabel.classList.toggle('hidden', isOnSale);
                salePriceLabel.classList.toggle('hidden', !isOnSale);
            }

            if (comparePrice && comparePriceValue) {
                comparePriceValue.textContent = swatch.dataset.comparePrice || '';
                comparePrice.classList.toggle('hidden', !isOnSale);
            }

            if (saleBadge) {
                saleBadge.classList.toggle('hidden', !isOnSale);
            }
        };

        root.querySelectorAll('[data-product-swatch].active').forEach((swatch) => {
            const card = swatch.closest('[data-product-card]');

            if (card) {
                updateProductCard(card, swatch);
            }
        });

        // Swatch event handler
        root.addEventListener('click', (event) => {
            const swatch = event.target instanceof Element
                ? event.target.closest('[data-product-swatch]')
                : null;

            if (!swatch || !root.contains(swatch)) return;

            const card = swatch.closest('[data-product-card]');
            if (!card) return;

            card.querySelectorAll('[data-product-swatch]').forEach((item) => {
                const isActive = item === swatch;
                item.classList.toggle('active', isActive);
                item.setAttribute('aria-pressed', String(isActive));
            });

            updateProductCard(card, swatch);
        });
    })();
</script>

{% schema %}
{
  "name": "Product list",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 3,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Product list"
    }
  ]
}
{% endschema %}
